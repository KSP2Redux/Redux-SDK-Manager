<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Redux_SDK_Manager.ViewModels"
             x:Class="Redux_SDK_Manager.Views.ProjectsView"
             x:DataType="vm:ProjectsViewModel">
    <UserControl.Styles>
        <!-- A project mid setup dims and can't be acted on until it finishes. -->
        <Style Selector="Border.settingup">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
    </UserControl.Styles>
    <Panel>
        <Grid RowDefinitions="Auto,*" Margin="18">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                <TextBlock Grid.Column="0" Text="Projects"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           FontFamily="{StaticResource JetBrainsMonoBold}" FontSize="18"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="New" Classes="success" Command="{Binding CreateProjectCommand}" />
                    <Button Content="Add Existing" Command="{Binding AddProjectCommand}" />
                    <Button Content="Add from Git" Command="{Binding AddFromGitCommand}" />
                    <Button Content="Refresh" Command="{Binding LoadCommand}" />
                </StackPanel>
            </Grid>

            <!-- Empty state -->
            <TextBlock Grid.Row="1" IsVisible="{Binding !HasProjects}"
                       Text="No projects tracked yet."
                       Foreground="{StaticResource TextFaintBrush}"
                       FontFamily="{StaticResource JetBrainsMonoLight}" FontSize="16"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />

            <!-- Project list -->
            <ScrollViewer Grid.Row="1" IsVisible="{Binding HasProjects}">
                <ItemsControl ItemsSource="{Binding Projects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:ProjectItemViewModel">
                            <Border Background="{StaticResource SurfacePanelTranslucentBrush}"
                                    BorderBrush="{StaticResource SurfacePanelBorderBrush}" BorderThickness="1"
                                    CornerRadius="{StaticResource RadiusMedium}"
                                    Padding="14,12" Margin="0,0,0,10"
                                    Classes.settingup="{Binding IsSettingUp}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   FontFamily="{StaticResource JetBrainsMonoBold}" FontSize="14" />
                                        <TextBlock Text="{Binding VersionLabel}"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                        <TextBlock Text="{Binding Path}"
                                                   Foreground="{StaticResource TextFaintBrush}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SetupStatus}" IsVisible="{Binding IsSettingUp}"
                                                   Foreground="{StaticResource BrandRedBrush}"
                                                   FontFamily="{StaticResource JetBrainsMonoRegular}" FontSize="11" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                                                VerticalAlignment="Center">
                                        <Button Content="Open" Classes="success" IsEnabled="{Binding !IsSettingUp}"
                                                Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).OpenCommand}"
                                                CommandParameter="{Binding}" />
                                        <!-- Kept enabled during setup so the log folder is reachable. -->
                                        <Button Content="Folder"
                                                Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).OpenFolderCommand}"
                                                CommandParameter="{Binding}" />
                                        <!-- Only offered until the game has been imported. -->
                                        <Button Content="Setup" IsVisible="{Binding NeedsSetup}" IsEnabled="{Binding !IsSettingUp}"
                                                Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).SetupCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Upgrade" IsEnabled="{Binding !IsSettingUp}"
                                                Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).UpgradeCommand}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="Remove" Classes="danger" IsEnabled="{Binding !IsSettingUp}"
                                                Command="{Binding $parent[ItemsControl].((vm:ProjectsViewModel)DataContext).RemoveCommand}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Busy scrim -->
        <Border IsVisible="{Binding IsBusy}" Background="{StaticResource ScrimSoftBrush}">
            <TextBlock Text="Working..."
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontFamily="{StaticResource JetBrainsMonoLight}" FontSize="20"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Panel>
</UserControl>
