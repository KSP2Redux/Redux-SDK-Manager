<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Redux_SDK_Manager.ViewModels"
             x:Class="Redux_SDK_Manager.Views.VersionsView"
             x:DataType="vm:VersionsViewModel">
    <Grid RowDefinitions="Auto,*" Margin="18">
        <!-- Header -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,14">
            <TextBlock Grid.Column="0" Text="Versions"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       FontFamily="{StaticResource JetBrainsMonoBold}" FontSize="18"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Loading..." IsVisible="{Binding IsBusy}"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontFamily="{StaticResource JetBrainsMonoRegular}" FontSize="12"
                       VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="2" Content="Refresh" Command="{Binding RefreshCommand}"
                    IsEnabled="{Binding !IsBusy}" />
        </Grid>

        <!-- Empty state (only when nothing loaded and not mid-load) -->
        <TextBlock Grid.Row="1" IsVisible="{Binding !HasVersions}"
                   Text="No template versions to show."
                   Foreground="{StaticResource TextFaintBrush}"
                   FontFamily="{StaticResource JetBrainsMonoLight}" FontSize="16"
                   HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- Version list, grouped by channel -->
        <ScrollViewer Grid.Row="1" IsVisible="{Binding HasVersions}">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:VersionCatalogGroupViewModel">
                        <StackPanel Margin="0,0,0,8">
                            <TextBlock Text="{Binding Channel}"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       FontFamily="{StaticResource JetBrainsMonoBold}" FontSize="12"
                                       Margin="2,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:VersionCatalogItemViewModel">
                                        <Border Background="{StaticResource SurfacePanelTranslucentBrush}"
                                                BorderBrush="{StaticResource SurfacePanelBorderBrush}" BorderThickness="1"
                                                CornerRadius="{StaticResource RadiusMedium}"
                                                Padding="14,12" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto,Auto">
                                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Raw}"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               FontFamily="{StaticResource JetBrainsMonoBold}" FontSize="14" />
                                                    <TextBlock Text="{Binding UnityVersionLabel}"
                                                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                                </StackPanel>

                                                <!-- Installed status -->
                                                <TextBlock Grid.Column="1" Text="{Binding InstalledLabel}"
                                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                                           FontFamily="{StaticResource JetBrainsMonoBold}" FontSize="12"
                                                           Foreground="{StaticResource SuccessBrush}"
                                                           IsVisible="{Binding IsInstalled}" />
                                                <TextBlock Grid.Column="1" Text="{Binding InstalledLabel}"
                                                           VerticalAlignment="Center" Margin="0,0,12,0"
                                                           FontFamily="{StaticResource JetBrainsMonoRegular}" FontSize="12"
                                                           Foreground="{StaticResource TextFaintBrush}"
                                                           IsVisible="{Binding !IsInstalled}" />

                                                <Button Grid.Column="2" Content="Install Unity"
                                                        IsVisible="{Binding CanInstall}"
                                                        Command="{Binding $parent[UserControl].((vm:VersionsViewModel)DataContext).InstallUnityCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
