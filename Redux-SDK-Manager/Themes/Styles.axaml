<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Design.PreviewWith>
        <Border Padding="20">
            <Button>Test Button</Button>
        </Border>
    </Design.PreviewWith>

    <Style Selector="Button">
        <Setter Property="Background" Value="{StaticResource NeutralButtonBrush}"></Setter>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"></Setter>
        <Setter Property="BorderThickness" Value="0"></Setter>
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"></Setter>
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource NeutralButtonHoverBrush}"></Setter>
        </Style>
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{StaticResource DangerBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource DangerHoverBrush}" />
        </Style>
    </Style>

    <Style Selector="Button.success">
        <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Style Selector="^:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource SuccessHoverBrush}" />
        </Style>
    </Style>

    <Style Selector="Button.link-button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ToolTip.ShowDelay" Value="0" />
        <Setter Property="ToolTip.Placement" Value="AnchorAndGravity" />
        <Setter Property="ToolTip.VerticalOffset" Value="30" />

        <Style Selector="^ > Canvas">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
        </Style>

        <Style Selector="^ Image">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Canvas.Left" Value="0" />
            <Setter Property="Canvas.Top" Value="0" />
        </Style>

        <Style Selector="^ Border.button-tint">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="^:pointerover">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="^ Border.button-tint">
                <Setter Property="Background" Value="{StaticResource OverlayHoverBrush}" />
            </Style>
        </Style>
        <Style Selector="^:pressed">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Style Selector="^ Border.button-tint">
                <Setter Property="Background" Value="{StaticResource OverlayPressedBrush}" />
            </Style>
        </Style>
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource JetBrainsMonoRegular}"></Setter>
    </Style>

    <!-- Retint the checked box off Fluent's system-accent teal onto the brand red. -->
    <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{StaticResource BrandRedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandRedBrush}" />
    </Style>
    <Style Selector="CheckBox:checked:pointerover /template/ Border#NormalRectangle">
        <Setter Property="Background" Value="{StaticResource BrandRedHoverBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BrandRedHoverBrush}" />
    </Style>

    <!-- Retint ListBox item hover/selection off Fluent's system-accent teal onto the brand palette. -->
    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ListHoverBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ListSelectionBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>
    <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{StaticResource ListSelectionBrush}" />
    </Style>
</Styles>
